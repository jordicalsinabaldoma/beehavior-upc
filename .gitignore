# Python environment
.venv/
__pycache__/
*.pyc

# The full dataset (7.8 GB). Download it from Mendeley:
#   https://doi.org/10.17632/8gb9r2yhfc.6
# dataset-sample/ holds a sample, so you can see the format without it.
data/
dataset.zip
dataset-minimal/

# Generated output. From out/ we DO version the figures and the saved
# detections (see the exceptions below); the 60 MB videos we do not.
out/*
!out/*.csv
!out/*.log
!out/*_eval.txt
!out/*_actividad.png
!out/*_dets.npz
runs/

# Ultralytics base weights, downloaded on first use
yolo11n.pt

# The box camera's original footage (27 MB). The repo carries a short loop
# under the same name; this is the long one, for recording demos locally.
box/assets/media/piquera_full.mp4

# Blender: the scene is rebuilt from blender/*.py, the .blend is the output
blender/*.blend
blender/*.blend[0-9]
blender/assets/
blender/renders/

# The pixel-art demo film: out of the repository
demo/

# Panel design experiments. Not part of the pipeline: nothing imports them.
out/mocks*/
src/mock_panels*.py

# Byte-for-byte copy of models/bee11n.pt
models/bee11n_e7.pt
